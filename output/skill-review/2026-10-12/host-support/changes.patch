+"""Exercise the extractor lookup with Antigravity-only installation layouts."""
+
+import os
+from pathlib import Path
+import subprocess
+
+import pytest
+
+
+ROOT = Path(__file__).resolve().parent.parent
+SKILL = (ROOT / "SKILL.md").read_text(encoding="utf-8")
+
+
+@pytest.mark.parametrize(
+    "layout",
+    ["project", "legacy-project", "personal-ide", "personal-cli", "legacy-personal"],
+)
+@pytest.mark.skipif(os.name == "nt", reason="the spec's lookup uses POSIX Bash paths")
+def test_antigravity_extractor_lookup(tmp_path, layout):
+    home = tmp_path / "home"
+    project = tmp_path / "project"
+    project.mkdir()
+    subprocess.run(["git", "init", "-q"], cwd=project, check=True)
+    nested = project / "src" / "nested"
+    nested.mkdir(parents=True)
+    destinations = {
+        "project": project / ".agents" / "skills",
+        "legacy-project": project / ".agent" / "skills",
+        "personal-ide": home / ".gemini" / "config" / "skills",
+        "personal-cli": home / ".gemini" / "antigravity-cli" / "skills",
+        "legacy-personal": home / ".gemini" / "antigravity" / "skills",
+    }
+    extractor = destinations[layout] / "book-to-skill" / "scripts" / "extract.py"
+    extractor.parent.mkdir(parents=True)
+    extractor.touch()
+    start = SKILL.index('SCRIPT_PATH=""')
+    end = SKILL.index('\nif [ -z "$SCRIPT_PATH" ]', start)
+    probe = SKILL[start:end] + '\nprintf "%s" "$SCRIPT_PATH"\n'
+    env = os.environ.copy()
+    env["HOME"] = str(home)
+    for key in ["HERMES_AGENT", "HERMES_HOME", "OPENCLAW_STATE_DIR"]:
+        env.pop(key, None)
+    result = subprocess.run(
+        ["bash", "-c", probe], cwd=nested, env=env, check=True,
+        capture_output=True, text=True,
+    )
+    selected = Path(result.stdout.strip())
+    if not selected.is_absolute():
+        selected = nested / selected
+    assert selected.resolve() == extractor.resolve()
